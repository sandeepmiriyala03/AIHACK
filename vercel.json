{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/main.py": {
      "maxDuration": 10,
      "excludeFiles": "{.next/**,.vercel/**,.wa-session/**,node_modules/**,public/**,src/**,components/**,hooks/**,lib/**,services/**,ocr-api/**,**/__pycache__/**,**/*.pyc,**/*.map,**/*.md,**/*.log}"
    }
  },
  "rewrites": [
    { "source": "/api/main/:path*", "destination": "/api/main" }
  ]
}